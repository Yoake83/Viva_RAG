# --- Runtime ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Persistence (SQLite works for quick local runs; Postgres for real use) ---
DATABASE_URL=postgresql+psycopg://viva:viva@localhost:5432/viva
# DATABASE_URL=sqlite:///./viva.db

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- RAG ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_DIR=./storage/chroma
CHUNK_TARGET_WORDS=220
CHUNK_OVERLAP_WORDS=40
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.35

# --- Interview ---
QUESTIONS_PER_INTERVIEW=6
